# ---------------------------------------------------------------
# The Royal Automation — backend environment variables
# Local development: copy to backend/.env.   Vercel: add these in
# Project → Settings → Environment Variables.  NEVER commit .env.
# ---------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas recommended)
MONGODB_URI=mongodb://127.0.0.1:27017/royal_automation

# Long random secret (min 32 chars in production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# First admin user — created automatically on first start if no admin exists.
# Password: at least 10 characters. You can remove ADMIN_PASSWORD after the first login.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public website URL for sitemap.xml / robots.txt (can also be set in Admin → Settings → SEO)
PUBLIC_SITE_URL=

# ---- Optional ----------------------------------------------------
PORT=5000
# Allowed browser origins if the frontend runs on a DIFFERENT domain (comma-separated).
CLIENT_URL=http://localhost:5173
# Where uploaded images & attachments are stored: gridfs (MongoDB, default, works on Vercel) or disk
STORAGE_DRIVER=gridfs
UPLOAD_DIR=uploads
# Upload limits (defaults: 4 MB on Vercel because of its 4.5 MB request limit; 10/25 MB elsewhere)
# MAX_UPLOAD_MB=4
# MAX_TOTAL_UPLOAD_MB=4
# MAX_FILES=5
# Cookies: on HTTPS production these default to secure. If the frontend and API are on
# different domains, set COOKIE_SAMESITE=none.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# Serve frontend/dist from Express (VPS single-server deployment only)
SERVE_CLIENT=false
