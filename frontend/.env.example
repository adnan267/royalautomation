# Leave VITE_API_URL empty on Vercel (website and API share one domain) and for local dev (Vite proxy).
# Only set it if the API is hosted on a different domain, e.g. https://api.yourdomain.com
VITE_API_URL=

# Optional: public website URL (canonical links fall back to Admin → Settings → SEO, then the current domain)
VITE_SITE_URL=

# Local dev only: where the Vite dev server forwards /api and /uploads
VITE_DEV_API_TARGET=http://localhost:5000
